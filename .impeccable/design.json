  "components": [
    {
      "name": "Palheta de estado",
      "kind": "custom",
      "refersTo": "flap",
      "description": "Estado da worktree em 7 caracteres; vira em 3 quadros só quando o estado muda.",
      "html": "<span class=\"ds-flap\" data-state=\"run\"><span>RODANDO</span></span> <span class=\"ds-flap\" data-state=\"wait\"><span>AGUARDA</span></span> <span class=\"ds-flap\" data-state=\"stop\"><span>PARANDO</span></span> <span class=\"ds-flap\" data-state=\"idle\"><span>PARADA</span></span> <span class=\"ds-flap\" data-state=\"none\"><span></span></span>",
      "css": ".ds-flap{position:relative;display:inline-grid;place-items:center;width:calc(7ch + 14px);height:22px;border-radius:2px;background:linear-gradient(var(--flap-hi) 50%,var(--flap) 50%);color:var(--ink-2);font:700 12px/1 var(--ui);letter-spacing:.06em;overflow:hidden}.ds-flap::after{content:'';position:absolute;inset:50% 0 auto;height:1px;background:var(--seam)}.ds-flap>span{position:relative;z-index:1}.ds-flap[data-state=run]{color:var(--run)}.ds-flap[data-state=start]{color:var(--start)}.ds-flap[data-state=wait]{color:var(--wait)}.ds-flap[data-state=stop]{color:var(--stop)}.ds-flap.flip>span{animation:ds-flip 180ms steps(3,jump-none)}@keyframes ds-flip{50%{transform:scaleY(.12)}}@media (prefers-reduced-motion:reduce){.ds-flap.flip>span{animation:none}}"
    },
    {
      "name": "Linha do painel",
      "kind": "custom",
      "refersTo": "line",
      "description": "Worktree no painel: palheta, branch com prefixo em meia-tinta; atual com fundo de palheta e fios internos.",
      "html": "<button class=\"ds-line\" aria-current=\"true\"><span class=\"ds-flap\" data-state=\"run\"><span>RODANDO</span></span><span class=\"ds-branch\"><span class=\"ds-prefix\">feat/</span>scrap-movement</span></button><button class=\"ds-line\"><span class=\"ds-flap\" data-state=\"idle\"><span>PARADA</span></span><span><span class=\"ds-prefix\">fix/</span>login</span></button>",
      "css": ".ds-flap{position:relative;display:inline-grid;place-items:center;width:calc(7ch + 14px);height:22px;border-radius:2px;background:linear-gradient(var(--flap-hi) 50%,var(--flap) 50%);color:var(--ink-2);font:700 12px/1 var(--ui);letter-spacing:.06em;overflow:hidden}.ds-flap::after{content:'';position:absolute;inset:50% 0 auto;height:1px;background:var(--seam)}.ds-flap>span{position:relative;z-index:1}.ds-flap[data-state=run]{color:var(--run)}.ds-flap[data-state=start]{color:var(--start)}.ds-flap[data-state=wait]{color:var(--wait)}.ds-flap[data-state=stop]{color:var(--stop)}.ds-flap.flip>span{animation:ds-flip 180ms steps(3,jump-none)}@keyframes ds-flip{50%{transform:scaleY(.12)}}@media (prefers-reduced-motion:reduce){.ds-flap.flip>span{animation:none}}.ds-line{display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:10px;width:280px;padding:5px 10px 5px 14px;border:0;background:none;color:var(--ink-2);font:500 15px/1.35 var(--ui);text-align:left;cursor:pointer}.ds-line:hover{background:var(--flap)}.ds-line[aria-current=true]{background:var(--flap);color:var(--ink);box-shadow:inset 0 -1px 0 var(--rule),inset 0 1px 0 var(--rule)}.ds-prefix{color:var(--ink-2)}.ds-line:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Abas API | FRONT",
      "kind": "nav",
      "refersTo": "tab",
      "description": "A aba selecionada vira palheta; as outras são contorno em meia-tinta.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab\" aria-selected=\"true\"><span>API</span></button><button class=\"ds-tab\"><span>FRONT</span></button></div>",
      "css": ".ds-tabs{display:flex;gap:4px}.ds-tab{position:relative;height:26px;padding:0 12px;border:1px solid var(--rule);border-radius:2px;background:none;color:var(--ink-2);font:700 12px/1 var(--ui);letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.ds-tab>span{position:relative;z-index:1}.ds-tab[aria-selected=true]{border-color:transparent;background:linear-gradient(var(--flap-hi) 50%,var(--flap) 50%);color:var(--ink)}.ds-tab[aria-selected=true]::after{content:'';position:absolute;inset:50% 0 auto;height:1px;background:var(--seam)}.ds-tab:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
