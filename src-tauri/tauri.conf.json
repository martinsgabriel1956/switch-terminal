{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "switch-terminal",
  "version": "0.1.0",
  "identifier": "dev.gabriel.switch-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "switch-terminal",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Troca de terminais entre worktrees",
    "longDescription": "Alterna entre worktrees de projetos com API e front em repositórios separados, com um terminal para cada lado."
  }
}
